# Copy to .env.local and adjust for your deployment. Never commit .env.local.

# Required in production builds only. The origin this app is deployed at —
# used to build the OAuth client_id (must match public/client-metadata.json's
# client_id and redirect_uris exactly). Not needed in dev (the OAuth client
# falls back to the AT Protocol "loopback client" for localhost/127.0.0.1).
VITE_APP_URL=https://your-domain.example

# Handle resolution service, contacted to turn @handle.example into a DID
# (sign-in, mentions, profile lookups). Defaults to https://bsky.social.
# Point this at your own PDS or a self-hosted DoH resolver to avoid relying
# on Bluesky's infrastructure for resolution.
VITE_HANDLE_RESOLVER=https://bsky.social

# Log every outgoing HTTP request (method, URL without query string, status,
# duration — never headers/bodies/tokens) to the console. Defaults to "true"
# in dev, "false" in production builds.
VITE_DEBUG_NETWORK=true
